
<% content_for :title, "Software Licenses" %>

<h1>Software Licenses</h1>

<% [
  ["Microsoft Office", 10, 1],
  ["Microsoft Windows", 10, 2],
  ["Adobe Pro", 10, 3]
].each do |name, license_count, license_id| %>
  <div>
    <p>
      <strong>Name:</strong>
      <%= name %>
    </p>

    <p>
      <strong>License count:</strong>
      <%= license_count %>
    </p>

    <%= link_to "Show this software license", software_license_path(license_id) %>
  </div>
<% end %>

<%= link_to "New software license", new_software_license_path %>

