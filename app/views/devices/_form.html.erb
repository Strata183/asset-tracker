<%= form_with(model: device) do |form| %>
  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :device_type, class: "form-label" %>
    <%= form.text_field :device_type, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :serial_number, class: "form-label" %>
    <%= form.text_field :serial_number, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :user_id, "Assigned User", class: "form-label" %>
    <%= form.collection_select :user_id, User.all, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, { include_blank: "Unassigned" }, { class: "form-select" } %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>
